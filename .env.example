# Copy this file to .env and fill in your values. Never commit .env.

# Hindsight Cloud API key (sign up at https://ui.hindsight.vectorize.io)
HINDSIGHT_API_KEY=

# Hindsight endpoint. Default is Hindsight Cloud.
# For a self-hosted server use e.g. http://localhost:8888 (API key optional there).
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# Memory bank that holds all DealMind memories
HINDSIGHT_BANK_ID=dealmind

# LLM key for the agent itself (Groq / OpenAI / Gemini). Not used in the Hindsight foundation step.
LLM_API_KEY=
